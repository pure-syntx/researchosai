'use client';

import React, { useState } from 'react';
import Icon from '@/components/ui/AppIcon';

const mockEquations = [
  {
    id: 'eq-1',
    label: 'Scaled Dot-Product Attention',
    latex: 'Attention(Q, K, V) = softmax(QKᵀ / √dₖ) · V',
    plain: 'Attention(Q, K, V) = softmax(QK^T / sqrt(d_k)) * V',
    explanation:
      'This is the core attention formula. Q (Query), K (Key), and V (Value) are matrices derived from the input. The dot product QKᵀ measures similarity between queries and keys. Dividing by √dₖ prevents vanishingly small gradients when dₖ is large. Softmax normalizes the scores into probabilities, which are then used to weight the values V.',
    intuition: 'Think of it as a soft lookup: for each query, find how relevant each key is, then return a weighted average of the values.',
    variables: [
      { symbol: 'Q', meaning: 'Query matrix — what we are looking for' },
      { symbol: 'K', meaning: 'Key matrix — what each position offers' },
      { symbol: 'V', meaning: 'Value matrix — the actual content to retrieve' },
      { symbol: 'dₖ', meaning: 'Dimension of key vectors (scaling factor)' },
    ],
    difficulty: 'Core',
    difficultyColor: 'text-primary bg-primary/10 border-primary/20',
  },
  {
    id: 'eq-2',
    label: 'Multi-Head Attention',
    latex: 'MultiHead(Q,K,V) = Concat(head₁,…,headₕ)Wᴼ',
    plain: 'MultiHead(Q,K,V) = Concat(head_1,...,head_h) * W^O',
    explanation:
      'Instead of performing a single attention function, multi-head attention runs h parallel attention operations (heads) with different learned projections. Each head can attend to different aspects of the input. The outputs are concatenated and projected back to the model dimension.',
    intuition: 'Like having multiple experts each focusing on different relationships in the data, then combining their insights.',
    variables: [
      { symbol: 'h', meaning: 'Number of attention heads (8 in the paper)' },
      { symbol: 'headᵢ', meaning: 'Output of the i-th attention head' },
      { symbol: 'Wᴼ', meaning: 'Output projection matrix' },
    ],
    difficulty: 'Intermediate',
    difficultyColor: 'text-accent bg-accent/10 border-accent/20',
  },
  {
    id: 'eq-3',
    label: 'Positional Encoding',
    latex: 'PE(pos,2i) = sin(pos / 10000^(2i/dmodel))',
    plain: 'PE(pos, 2i) = sin(pos / 10000^(2i/d_model))',
    explanation:
      'Since the Transformer has no recurrence, it needs a way to encode the order of tokens. Positional encodings are added to the input embeddings. Even dimensions use sine, odd dimensions use cosine. The different frequencies allow the model to learn to attend to relative positions.',
    intuition: 'Like giving each word a unique "address" based on its position, using a combination of sine waves at different frequencies.',
    variables: [
      { symbol: 'pos', meaning: 'Position of the token in the sequence' },
      { symbol: 'i', meaning: 'Dimension index' },
      { symbol: 'dmodel', meaning: 'Model embedding dimension (512)' },
    ],
    difficulty: 'Foundational',
    difficultyColor: 'text-warning bg-warning/10 border-warning/20',
  },
];

export default function EquationsPanel() {
  const [activeEq, setActiveEq] = useState<string>(mockEquations[0].id);
  const [showVariables, setShowVariables] = useState<Record<string, boolean>>({});

  const selected = mockEquations.find((e) => e.id === activeEq) ?? mockEquations[0];

  return (
    <div className="flex flex-col gap-4 animate-slide-up">
      {/* Header */}
      <div className="flex items-center gap-2">
        <div className="w-6 h-6 rounded-md bg-accent/15 flex items-center justify-center">
          <Icon name="SigmaIcon" size={13} className="text-accent" />
        </div>
        <div>
          <h3 className="text-sm font-bold text-foreground">Equations Explained</h3>
          <p className="text-2xs text-muted-foreground">{mockEquations.length} equations found · Plain-English explanations</p>
        </div>
      </div>

      {/* Equation selector */}
      <div className="flex flex-col gap-1.5">
        {mockEquations.map((eq) => (
          <button
            key={eq.id}
            onClick={() => setActiveEq(eq.id)}
            className={`flex items-center gap-3 px-3 py-2.5 rounded-lg border text-left transition-all duration-150
              ${activeEq === eq.id
                ? 'bg-accent/10 border-accent/30 text-foreground'
                : 'bg-muted/20 border-border hover:bg-muted/40 text-muted-foreground hover:text-foreground'
              }`}
          >
            <div className={`w-7 h-7 rounded-md flex items-center justify-center flex-shrink-0 text-2xs font-mono font-bold
              ${activeEq === eq.id ? 'bg-accent/20 text-accent' : 'bg-muted/50 text-muted-foreground'}`}>
              {eq.id.split('-')[1]}
            </div>
            <div className="flex-1 min-w-0">
              <p className="text-xs font-semibold truncate">{eq.label}</p>
              <p className="text-2xs font-mono truncate opacity-70">{eq.plain}</p>
            </div>
            <span className={`text-2xs font-semibold border px-1.5 py-0.5 rounded flex-shrink-0 ${eq.difficultyColor}`}>
              {eq.difficulty}
            </span>
          </button>
        ))}
      </div>

      {/* Selected equation detail */}
      <div className="glass-card p-4 gradient-border flex flex-col gap-4">
        {/* Equation display */}
        <div className="bg-background/60 rounded-xl p-4 border border-border/50">
          <p className="text-2xs font-semibold uppercase tracking-widest text-muted-foreground mb-2">Formula</p>
          <p className="font-mono text-sm text-primary leading-relaxed break-all">{selected.latex}</p>
        </div>

        {/* Explanation */}
        <div>
          <p className="text-2xs font-semibold uppercase tracking-widest text-muted-foreground mb-2">Plain-English Explanation</p>
          <p className="text-xs text-muted-foreground leading-relaxed">{selected.explanation}</p>
        </div>

        {/* Intuition */}
        <div className="bg-primary/5 border border-primary/15 rounded-lg px-3 py-2.5 flex items-start gap-2">
          <Icon name="LightbulbIcon" size={14} className="text-primary flex-shrink-0 mt-0.5" />
          <p className="text-xs text-foreground/80 leading-relaxed italic">{selected.intuition}</p>
        </div>

        {/* Variables */}
        <div>
          <button
            onClick={() => setShowVariables((prev) => ({ ...prev, [selected.id]: !prev[selected.id] }))}
            className="flex items-center gap-2 text-2xs font-semibold text-muted-foreground hover:text-foreground transition-colors mb-2"
          >
            <Icon name={showVariables[selected.id] ? 'ChevronUpIcon' : 'ChevronDownIcon'} size={12} />
            Variable Reference ({selected.variables.length})
          </button>
          {showVariables[selected.id] && (
            <div className="flex flex-col gap-1.5 animate-fade-in">
              {selected.variables.map((v) => (
                <div key={v.symbol} className="flex items-start gap-2 px-2 py-1.5 rounded-lg bg-muted/30">
                  <span className="font-mono text-xs font-bold text-accent w-10 flex-shrink-0">{v.symbol}</span>
                  <span className="text-xs text-muted-foreground">{v.meaning}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
